# Скопируй этот файл в .env и заполни. Файл .env не попадает в GitHub.

# ── Обязательно ──
# Токен бота от @BotFather
BOT_TOKEN=
# Домен сервера без https:// (для автоматического сертификата)
DOMAIN=game.example.com
# Адрес игры — тот же домен с https://
WEBAPP_URL=https://game.example.com
# Пароль от админки (/admin). Придумай длинный и сложный
ADMIN_PASSWORD=

# ── Желательно ──
# Твой Telegram ID (узнать: @userinfobot). Через запятую, если админов несколько.
# Админы получают уведомления о покупках, тест рассылок и команду /stats
ADMIN_IDS=
# Короткое имя Mini App из BotFather (/newapp) — реферальные ссылки будут сразу открывать игру
APP_SHORT_NAME=
# Название игры в сообщениях бота
APP_TITLE=Gold Rush
# Куда писать по вопросам оплаты (например, @your_support)
SUPPORT_CONTACT=

# ── Для разработки ──
PORT=3000
# 1 — можно открыть игру в браузере: http://localhost:3000/?dev=1
# На сервере ОБЯЗАТЕЛЬНО 0
DEV_MODE=0
